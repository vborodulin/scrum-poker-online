NODE_ENV=development
ENV=development

# directory of the `config` package, relative to server/
NODE_CONFIG_DIR=./config

# --- server ---
APP_PORT=8083
APP_ADDRESS=0.0.0.0

APP_COOKIE_SESSION_NAME=chpokify-sid
# required: any random string, e.g. `openssl rand -hex 32`
APP_SECRET=secret

LOGGER_PROJECT=chpokify
LOGGER_NAME=main-server
LOGGER_LEVEL=debug

# --- databases (hosts are docker-compose service names) ---
REDIS_HOST=redis
REDIS_PORT=6377

MONGO_HOST=mongodb
MONGO_PORT=27018
MONGO_DB_NAME=poker
# required: applied only when the mongo volume is first created
# (after changing it run `docker-compose down -v`)
MONGO_ROOT_PASSWORD=

# --- optional integrations ---
SERVER_SENTRY_DSN=
CLIENT_SENTRY_DSN=
STRIPE_SECRET_KEY=

# --- local URLs and ports ---
# if NGINX_PORT is not 80, add it to these three URLs (e.g. http://localhost:8000)
CLIENT_DOMAIN=http://localhost
BASE_API_CLIENT_URL=http://localhost
BASE_API_SSR_URL=http://localhost

# nginx port on host
NGINX_PORT=80

# port of frontend (next dev) inside docker network
CLIENT_PORT=3000

# --- figma icons import (`yarn figma:import`), not needed to run the app ---
FIGMA_TOKEN=
FIGMA_FILE_KEY=NZO68r9ueRzMtEN1qUsVgC
FIGMA_ICONS_NODE_ID=718:4858
# relative to figma/
CLIENT_ICONS_DIR=../frontend/components/uiKit/Icons
